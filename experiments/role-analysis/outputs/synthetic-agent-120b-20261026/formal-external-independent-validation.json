  "position_semantics": "position_bin is the quartile of absolute token position in each whole actual input, not per-message relative body position or the last quarter of each message body.",
  "formulas": {
    "prediction": "six-class argmax of committed float32 probabilities",
    "confusion": "M[i,j]=count(y=i and argmax(p)=j)",
    "accuracy": "trace(M)/sum(M)",
    "precision": "M[r,r]/sum(M[:,r]); absent predictions => null",
    "recall": "M[r,r]/sum(M[r,:]); absent true support => null",
    "f1": "2*M[r,r]/(support_r+predicted_r); absent true support => null",
    "macro_f1": "arithmetic mean F1 over classes with true support; overall external evaluation has only user and assistant true support",
    "nll": "mean(-log(clip(float64(p[row,y]),1e-30,1)))"
  },
  "limitations": [
    "This verifies committed labels/probabilities/group metadata; it does not rerun the frozen model or verify x feature vectors.",
    "Subgroup macro-F1 averages only roles with true support; stages with only cot or tool targets are not six-class tests.",
    "Position groups here use whole-input absolute quartiles; per-body tail diagnostics require the separate position report.",
    "External diagnostics do not alter the already frozen DEV-only selection."
